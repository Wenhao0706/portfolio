# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin/create (choose v3)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Gmail SMTP — requires 2FA enabled on the account, then generate an App
# Password at https://myaccount.google.com/apppasswords (NOT your login password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where contact form submissions get sent
CONTACT_TO_EMAIL=

# Upstash Redis — backs the contact form's per-IP rate limit (3 submissions / 10 min).
# Free tier, no credit card: https://console.upstash.com/redis
# Both gates fail open, so local development works with these unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Chatbot agent on EC2 — the Cloudflare Tunnel hostname fronting agent/server.mjs, and
# the bearer secret that server checks. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and set the SAME value in the box's systemd unit.
#
# Unset is a supported state: lib/chat/agent.ts fails closed and the widget says it is
# offline, so local development works without a box. These bind at BUILD time on Vercel —
# setting them requires a redeploy before they take effect.
CHAT_AGENT_URL=
CHAT_AGENT_SECRET=
